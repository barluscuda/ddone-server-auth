{
  "info": {
    "_postman_id": "3ba679ca-daf5-4ae7-a16f-13a6bc02eb04",
    "name": "ddone-server-auth",
    "description": "Postman collection for the DDONE auth service registration, password, login, refresh, and JWKS flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Healthz",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "Checks service liveness."
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('ticketId', body.data.ticketId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Starts registration and stores ticketId from the response."
      }
    },
    {
      "name": "Resend Register OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": \"{{ticketId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register/resend",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register",
            "resend"
          ]
        },
        "description": "Resends the OTP for the saved ticketId."
      }
    },
    {
      "name": "Verify Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('accountId', body.data.id);",
              "  pm.environment.set('username', body.data.username || '');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": \"{{ticketId}}\",\n  \"otpCode\": \"{{otpCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register",
            "verify"
          ]
        },
        "description": "Completes registration after you fill in otpCode."
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('accessToken', body.data.accessToken);",
              "  pm.environment.set('refreshToken', body.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Authenticates and stores accessToken plus refreshToken."
      }
    },
    {
      "name": "Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('accessToken', body.data.accessToken);",
              "  pm.environment.set('refreshToken', body.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login",
            "refresh"
          ]
        },
        "description": "Uses the saved refreshToken and rotates it."
      }
    },
    {
      "name": "Create Login Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.test('session cookie stored in cookie jar', function () {",
              "    pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(true);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login",
            "session"
          ]
        },
        "description": "Authenticates and stores a persistent session identifier in Postman's cookie jar while keeping the JWT in server-side session state."
      }
    },
    {
      "name": "Session Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('accessToken', body.data.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/login/session/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login",
            "session",
            "token"
          ]
        },
        "description": "Uses the session cookie from Postman's cookie jar and returns the stored access token for the session or a fresh one if the previous token has expired."
      }
    },
    {
      "name": "Forgot Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('resetTicketId', body.data.ticketId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password/forgot",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "password",
            "forgot"
          ]
        },
        "description": "Starts password reset and stores resetTicketId from the response."
      }
    },
    {
      "name": "Resend Forgot Password OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": \"{{resetTicketId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password/forgot/resend",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "password",
            "forgot",
            "resend"
          ]
        },
        "description": "Resends the password-reset OTP for the saved resetTicketId."
      }
    },
    {
      "name": "Verify Forgot Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.environment.set('password', pm.environment.get('newPassword'));",
              "  pm.environment.set('currentPassword', pm.environment.get('newPassword'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketId\": \"{{resetTicketId}}\",\n  \"otpCode\": \"{{resetOtpCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password/forgot/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "password",
            "forgot",
            "verify"
          ]
        },
        "description": "Completes password reset after you fill in resetOtpCode."
      }
    },
    {
      "name": "Account Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/account/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "account",
            "me"
          ]
        },
        "description": "Returns the current authenticated account from the Bearer access token."
      }
    },
    {
      "name": "Account Sessions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/account/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "account",
            "sessions"
          ]
        },
        "description": "Returns the login sessions for the current authenticated account."
      }
    },
    {
      "name": "Change Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.environment.set('password', pm.environment.get('newPassword'));",
              "  pm.environment.set('currentPassword', pm.environment.get('newPassword'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/account/password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "account",
            "password"
          ]
        },
        "description": "Changes the current account password and updates the saved password variables on success."
      }
    },
    {
      "name": "JWKS",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/.well-known/jwks.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ".well-known",
            "jwks.json"
          ]
        },
        "description": "Returns the public signing keys used for ES256 access-token verification."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
